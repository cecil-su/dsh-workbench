+"use strict";
+
+/**
+ * Create the worker-to-driver sender. The non-terminal `showing` notice must
+ * keep IPC connected so the later `done` or `error` outcome can be delivered.
+ */
+function createWin32DialogPost(send, isConnected, disconnect) {
+  return (message) => {
+    if (message.kind === "showing") {
+      send(message);
+      return;
+    }
+    send(message, () => {
+      if (isConnected()) disconnect();
+    });
+  };
+}
+
+module.exports = { createWin32DialogPost };
